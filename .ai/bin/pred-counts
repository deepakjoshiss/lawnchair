#!/usr/bin/env python3
"""Decode Lawnchair's lawnchair-predictions DataStore (Preferences proto) and count launches per app.
Preferences proto: repeated map<string key, Value>; Value.string_value is field 5. Minimal varint parser.

Usage: adb -s emulator-5554 exec-out run-as app.lawnchair.debug \
         cat files/datastore/lawnchair-predictions.preferences_pb > <file>; pred-counts <file>
(Use this, not `strings`: `strings` silently dropped entries once.)"""
import sys, collections
def varint(b, i):
    r = s = 0
    while True:
        x = b[i]; i += 1; r |= (x & 0x7f) << s; s += 7
        if x < 0x80: return r, i
def fields(b):
    i = 0
    while i < len(b):
        tag, i = varint(b, i); f, wt = tag >> 3, tag & 7
        if wt == 2:
            n, i = varint(b, i); yield f, b[i:i+n]; i += n
        elif wt == 0:
            v, i = varint(b, i); yield f, v
        elif wt == 5: yield f, b[i:i+4]; i += 4
        elif wt == 1: yield f, b[i:i+8]; i += 8
        else: raise ValueError(wt)
data = open(sys.argv[1], 'rb').read()
for f, entry in fields(data):                       # PreferenceMap.preferences (map entries)
    kv = dict(fields(entry))
    key = kv.get(1, b'').decode()
    value = dict(fields(kv.get(2, b''))).get(5)      # Value.string = field 5 in androidx proto
    if value is None: continue
    items = [x for x in value.decode().split(';') if x]
    c = collections.Counter(x.split('/')[0] for x in items)
    print(f"{key}: {len(items)} entries")
    for pkg, n in c.most_common(): print(f"  {n:3d} {pkg}")
