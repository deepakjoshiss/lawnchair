#!/usr/bin/env bash
# Emulator UI helper for checks (uiautomator text lookup). DEV overrides the device (default emulator-5554).
# usage: ui.sh texts | tap "<exact text>" | waitfor "<text>" | shot <file>
set -u
e() { adb -s "${DEV:-emulator-5554}" "$@"; }
dump() { e exec-out uiautomator dump /dev/tty 2>/dev/null; }
case "$1" in
  texts) dump | grep -o 'text="[^"]\+"' ;;
  tap)
    b=$(dump | grep -o "text=\"$2\"[^>]*bounds=\"[^\"]*\"" | head -1 | grep -o 'bounds="[^"]*"' | grep -oE '[0-9]+' | tr '\n' ' ')
    [ -z "$b" ] && { echo "no '$2' on screen"; exit 1; }
    label=$2; set -- $b; x=$(( ($1+$3)/2 )); y=$(( ($2+$4)/2 ))
    e shell input tap $x $y; echo "tapped '$label' at $x,$y" ;;
  waitfor)
    for _ in $(seq 1 20); do dump | grep -q "text=\"$2\"" && { echo "found '$2'"; exit 0; }; done
    echo "TIMEOUT waiting for '$2'"; exit 1 ;;
  shot) e exec-out screencap -p > "$2"; echo "shot $2" ;;
esac
