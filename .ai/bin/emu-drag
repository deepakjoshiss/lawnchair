#!/usr/bin/env bash
# Long-press at x1,y1 and drag to x2,y2 on the emulator, optionally screenshotting before release.
# Moves up first (away from an icon's shortcut popup, which otherwise takes the drag).
# Long-press edit mode shrinks the page slightly: aim at the item's on-screen spot.
# usage: emu-drag x1 y1 x2 y2 [mid-drag.png]   DEV overrides the device (default emulator-5554)
set -u
e() { adb -s "${DEV:-emulator-5554}" "$@"; }
e shell input motionevent DOWN "$1" "$2"; sleep 0.9
e shell input motionevent MOVE "$1" $(( $2 - 120 )); sleep 0.3
for i in 1 2 3 4 5 6 7 8; do
  e shell input motionevent MOVE $(( $1 + ($3 - $1) * i / 8 )) $(( $2 + ($4 - $2) * i / 8 ))
done
e shell input motionevent MOVE "$3" "$4"; sleep 1.2
[ -n "${5:-}" ] && e exec-out screencap -p > "$5"
e shell input motionevent UP "$3" "$4"; sleep 1.5
