    <!-- DJ(home-grid): long-press edit mode. A compact drop-target bar and small margins leave
         more room, so the page shrinks less (upstream values in brackets). The bar is a
         full-width veil whose lower 8dp lies over the page; that strip is part of the drop area
         (drag padding 0), and the text sits in the upper 28dp. -->
    <dimen name="dynamic_grid_drop_target_size">36dp</dimen> <!-- 56dp -->
    <dimen name="drop_target_top_margin">-16dp</dimen> <!-- 32dp; negative: up into the empty part of the status bar -->
    <dimen name="drop_target_bottom_margin">-8dp</dimen> <!-- 16dp -->
    <dimen name="drop_target_drag_padding">0dp</dimen> <!-- 14dp -->
    <dimen name="drop_target_bar_margin_horizontal">0dp</dimen>
    <dimen name="drop_target_text_size">14sp</dimen> <!-- 16sp -->
